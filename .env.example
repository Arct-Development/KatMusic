# ==========================================
# KatMusic Environment Variables Template
# Copy this file to .env or local.properties for local builds
# ==========================================

# Release Keystore Signing Credentials (Local builds)
RELEASE_STORE_FILE=app/release.keystore
RELEASE_STORE_PASSWORD=your_keystore_password_here
RELEASE_KEY_ALIAS=release_key
RELEASE_KEY_PASSWORD=your_key_password_here

# GitHub Actions Secrets (Set in Repo Settings -> Secrets):
# SIGNING_KEY=<base64-encoded-keystore-string>
# KEY_STORE_PASSWORD=<your-keystore-password>
# ALIAS=release_key
# KEY_PASSWORD=<your-key-password>

# Dedicated Group Blend Supabase project (client configuration).
# These are the project URL and publishable/anon key, NOT service-role secrets.
# The Android APK necessarily contains these values at runtime; secure access
# with Supabase Auth + Row Level Security, never by hiding the publishable key.
KATMUSIC_BLEND_SUPABASE_URL=https://YOUR-BLEND-PROJECT.supabase.co
KATMUSIC_BLEND_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
