{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "katmusic",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
