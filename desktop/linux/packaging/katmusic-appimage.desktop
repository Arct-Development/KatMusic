# KatMusic — AppImage desktop entry.
# Same identity as katmusic.desktop, but Exec is the bare binary name:
# inside the AppImage the executable lives at $APPDIR/usr/bin and there
# is no /opt/katmusic (that absolute path belongs to the deb/rpm layout).
# Used ONLY by the CI AppImage step; see .github/workflows/desktop.yml.
[Desktop Entry]
Name=KatMusic
Comment=Desktop music player — YouTube Music, lossless audio, Last.fm scrobbling
Exec=katmusic  %u
Icon=katmusic
Terminal=false
Type=Application
Categories=Audio;Music;AudioVideo;
MimeType=x-scheme-handler/katmusic;
StartupWMClass=katmusic
